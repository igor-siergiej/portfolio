---
type SchemaValue = string | number | boolean | null | undefined | SchemaValue[] | { [key: string]: SchemaValue };

interface Props {
    schema: { [key: string]: SchemaValue };
}

const { schema } = Astro.props;
---

<script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', ...schema })} />
