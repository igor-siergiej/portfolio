---
interface Props {
    items: string[];
}

const { items } = Astro.props;
---

<ul class="flex flex-wrap gap-1.5">
    {
        items.map((item) => (
            <li class="rounded-full border border-border px-2.5 py-1 font-mono text-[11px] text-muted-foreground">
                {item}
            </li>
        ))
    }
</ul>
