---
import { getCollection } from 'astro:content';
import { Activity, ArrowRight, Boxes, Cloud, KeyRound, Monitor, PenLine, ServerCog, ShieldCheck } from 'lucide-react';
import HeroTopology from '@/components/HeroTopology.astro';
import ProjectIcon from '@/components/ProjectIcon.astro';
import StackChips from '@/components/StackChips.astro';
import { siteConfig } from '@/config/site';
import Layout from '@/layouts/Layout.astro';
import { featuredProjects, publishedPosts } from '@/lib/content';

const projects = featuredProjects(await getCollection('projects')).slice(0, 4);
const posts = publishedPosts(await getCollection('posts')).slice(0, 3);
const formatter = new Intl.DateTimeFormat('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });

const running = [
    { icon: Boxes, value: '9', label: 'containerised services across five products' },
    { icon: ServerCog, value: '15', label: 'Compose stacks on one self-hosted Docker host' },
    { icon: Activity, value: '19', label: 'endpoints watched by Gatus, around the clock' },
    { icon: KeyRound, value: '0', label: 'long-lived cloud keys — GitHub OIDC only' },
];

const stack = [
    { icon: Monitor, label: 'Frontend', items: 'React 19, Astro, Tailwind v4, Vite' },
    { icon: ServerCog, label: 'Backend', items: 'Hono, Bun, MongoDB, Postgres' },
    { icon: Cloud, label: 'Infra', items: 'Terraform, AWS, Docker, Dokploy' },
    { icon: ShieldCheck, label: 'Quality', items: 'Vitest, Playwright, Biome, semantic-release' },
];

const primaryButton =
    'inline-flex items-center gap-2 rounded-full bg-primary px-6 py-3 text-sm text-primary-foreground transition-[background-color,transform] hover:-translate-y-0.5 hover:bg-foreground hover:text-background';
const secondaryButton =
    'inline-flex items-center gap-2 rounded-full border border-border bg-card px-6 py-3 text-sm transition-[border-color,color,transform] hover:-translate-y-0.5 hover:border-primary hover:text-primary';
---

<Layout title="Full-stack engineer" description={siteConfig.description} wide>
    <section class="grid items-center gap-12 lg:grid-cols-[1.05fr_1fr]">
        <div class="hero-copy">
            <p class="inline-flex items-center gap-2.5 rounded-full border border-border bg-card px-3.5 py-1.5 text-sm text-muted-foreground">
                <span class="status-dot"></span>
                Open to senior full-stack and platform roles
            </p>
            <h1 class="mt-7 font-display text-5xl leading-[1.02] tracking-tight text-balance sm:text-6xl xl:text-7xl">
                I design, build and run the whole thing.
            </h1>
            <p class="mt-7 max-w-xl text-lg text-muted-foreground">
                From React interfaces down to the Terraform that provisions them. Production TypeScript services, a
                self-hosted Docker host, zero click-ops — and a habit of writing down what I learn.
            </p>
            <div class="mt-9 flex flex-wrap gap-3">
                <a href="/projects" class={primaryButton}>
                    See selected work
                    <ArrowRight className="size-4" aria-hidden="true" />
                </a>
                <a href="/about" class={secondaryButton}>How I work</a>
            </div>
        </div>
        <HeroTopology />
    </section>

    <section aria-labelledby="running-heading" class="reveal mt-24 rounded-3xl bg-canopy p-8 text-canopy-foreground sm:p-10">
        <h2 id="running-heading" class="flex items-center gap-3 font-display text-2xl tracking-tight">
            <span class="status-dot"></span>
            Running right now
        </h2>
        <dl class="mt-8 grid grid-cols-2 gap-x-6 gap-y-8 lg:grid-cols-4">
            {
                running.map((item) => (
                    <div class="border-t border-canopy-foreground/15 pt-5">
                        <item.icon className="size-5 text-pollen" strokeWidth={1.6} aria-hidden="true" />
                        <dt class="sr-only">{item.label}</dt>
                        <dd>
                            <span class="mt-3 block font-display text-4xl tracking-tight sm:text-5xl">{item.value}</span>
                            <span class="mt-2 block text-sm text-canopy-foreground/70" aria-hidden="true">
                                {item.label}
                            </span>
                        </dd>
                    </div>
                ))
            }
        </dl>
    </section>

    <section class="mt-24">
        <div class="flex items-baseline justify-between border-b border-border pb-4">
            <h2 class="font-display text-3xl tracking-tight">Selected work</h2>
            <a href="/projects" class="group inline-flex items-center gap-1.5 text-sm text-muted-foreground hover:text-primary">
                All projects
                <ArrowRight className="size-3.5 transition-transform group-hover:translate-x-0.5" aria-hidden="true" />
            </a>
        </div>
        <ul>
            {
                projects.map((project) => (
                    <li class="reveal grid gap-4 border-b border-border py-7 md:grid-cols-[1fr_16rem]">
                        <a href={`/projects/${project.id}/`} class="work-row group flex gap-5">
                            <ProjectIcon slug={project.id} />
                            <div>
                                <h3 class="inline-flex items-center gap-2 font-display text-2xl tracking-tight transition-colors group-hover:text-primary">
                                    {project.data.title}
                                    <ArrowRight
                                        className="size-5 -translate-x-2 opacity-0 transition-[opacity,transform] group-hover:translate-x-0 group-hover:opacity-100"
                                        aria-hidden="true"
                                    />
                                </h3>
                                <p class="mt-2 max-w-prose text-muted-foreground">{project.data.summary}</p>
                            </div>
                        </a>
                        <div class="md:justify-self-end">
                            <StackChips items={project.data.stack} />
                        </div>
                    </li>
                ))
            }
        </ul>
    </section>

    <div class="mt-24 grid gap-16 lg:grid-cols-2">
        <section class="reveal">
            <div class="flex items-baseline justify-between border-b border-border pb-4">
                <h2 class="flex items-center gap-3 font-display text-3xl tracking-tight">
                    <PenLine className="size-6 text-primary" strokeWidth={1.6} aria-hidden="true" />
                    Writing
                </h2>
                <a href="/blog" class="text-sm text-muted-foreground hover:text-primary">Archive</a>
            </div>
            <ul>
                {
                    posts.map((post) => (
                        <li class="border-b border-border">
                            <a href={`/blog/${post.id}/`} class="group grid grid-cols-[7rem_1fr] gap-5 py-5">
                                <span class="font-mono text-xs leading-6 text-muted-foreground">
                                    {post.data.publishDate ? (
                                        <time datetime={post.data.publishDate.toISOString()}>
                                            {formatter.format(post.data.publishDate)}
                                        </time>
                                    ) : (
                                        '—'
                                    )}
                                </span>
                                <span class="font-display text-lg transition-colors group-hover:text-primary">
                                    {post.data.title}
                                </span>
                            </a>
                        </li>
                    ))
                }
            </ul>
        </section>

        <section class="reveal">
            <h2 class="border-b border-border pb-4 font-display text-3xl tracking-tight">Stack</h2>
            <dl class="mt-6 grid gap-x-6 gap-y-7 sm:grid-cols-2">
                {
                    stack.map((group) => (
                        <div class="flex gap-4">
                            <span class="grid size-10 shrink-0 place-items-center rounded-xl bg-accent text-accent-foreground">
                                <group.icon className="size-5" strokeWidth={1.6} aria-hidden="true" />
                            </span>
                            <div>
                                <dt class="text-sm text-muted-foreground">{group.label}</dt>
                                <dd class="mt-0.5">{group.items}</dd>
                            </div>
                        </div>
                    ))
                }
            </dl>
        </section>
    </div>

    <section class="reveal relative mt-28 overflow-hidden rounded-3xl border border-border bg-card px-8 py-16 text-center">
        <svg class="pointer-events-none absolute inset-0 h-full w-full text-border" aria-hidden="true">
            <defs>
                <pattern id="cta-dots" width="18" height="18" patternUnits="userSpaceOnUse">
                    <circle cx="1.5" cy="1.5" r="1.5" fill="currentColor"></circle>
                </pattern>
            </defs>
            <rect width="100%" height="100%" fill="url(#cta-dots)"></rect>
        </svg>
        <div class="relative">
            <h2 class="font-display text-4xl tracking-tight text-balance sm:text-5xl">Let's build something that stays up.</h2>
            <p class="mt-4 text-muted-foreground">Email is fastest.</p>
            <div class="mt-8 flex flex-wrap justify-center gap-3">
                <a href={`mailto:${siteConfig.email}`} class={primaryButton}>
                    {siteConfig.email}
                </a>
                <a href={siteConfig.social.github} class={secondaryButton}>
                    GitHub
                </a>
                <a href={siteConfig.social.linkedin} class={secondaryButton}>
                    LinkedIn
                </a>
            </div>
        </div>
    </section>
</Layout>

<style>
    .work-row:hover :global(.project-icon) {
        transform: rotate(-8deg) scale(1.06);
        background-color: var(--primary);
        color: var(--primary-foreground);
    }
    @media (prefers-reduced-motion: no-preference) {
        .hero-copy > * {
            animation: hero-in 700ms cubic-bezier(0.2, 0.7, 0.2, 1) both;
        }
        .hero-copy > :nth-child(2) {
            animation-delay: 80ms;
        }
        .hero-copy > :nth-child(3) {
            animation-delay: 160ms;
        }
        .hero-copy > :nth-child(4) {
            animation-delay: 240ms;
        }
    }
    @keyframes hero-in {
        from {
            opacity: 0;
            transform: translateY(14px);
        }
    }
</style>
