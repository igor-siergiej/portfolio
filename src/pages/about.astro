---
import { siteConfig } from '@/config/site';
import { Code2, FileText, GraduationCap, Handshake, Layers, Rocket } from 'lucide-react';
import Layout from '@/layouts/Layout.astro';

const timeline = [
    {
        icon: Rocket,
        period: '2025 — present',
        title: 'Platform of personal products',
        body: 'Designed, built and operate five products — shoppingo, jewellery-catalogue, kivo, mixtape and sentinel — as nine containerised services on a single self-hosted Docker host, plus the shared @imapps packages all but sentinel depend on. Every stack is Compose-in-Git, deployed from pipelines.',
    },
    {
        icon: Handshake,
        period: '2026',
        title: 'Client work — Taisei Karate Academy',
        body: 'Astro site on S3 + CloudFront with Origin Access Control, a Lambda/SES contact pipeline, CloudTrail and alarm-based monitoring, deployed through GitHub OIDC.',
    },
    {
        icon: GraduationCap,
        period: '2021 — 2023',
        title: 'Graduate projects',
        body: 'A JavaFX diet planner over a nutrition dataset, an Android language-learning app in Kotlin, and a browser-based SQL teaching tool that renders schemas as interactive trees.',
    },
];

const principles = [
    {
        icon: Layers,
        title: 'Own it end to end',
        body: 'From the first sketch to the production alarm. The seam between an application and the platform it runs on is the part I enjoy most.',
    },
    {
        icon: Code2,
        title: 'Everything as code',
        body: "Terraform for AWS, Compose for the homelab, GitHub Actions with OIDC. If it can't be rebuilt from the repo, it isn't finished.",
    },
    {
        icon: FileText,
        title: 'Write it down',
        body: 'Decisions, trade-offs and gotchas go into docs next to the code, so the next person — or me in six months — can pick it up.',
    },
];
---

<Layout title="About" description="Full-stack engineer — background, how I work, and what I'm looking for.">
    <h1 class="font-display text-5xl tracking-tight">About</h1>

    <p class="mt-8 text-xl leading-relaxed text-balance">
        I'm a full-stack engineer happiest owning a feature from the first sketch to the production alarm. Most of my
        work is TypeScript — React and Astro on the front, Hono and Bun on the back.
    </p>
    <p class="mt-5 inline-flex items-center gap-2.5 text-muted-foreground">
        <span class="status-dot"></span>
        Open to senior full-stack and platform roles, UK-based or remote.
    </p>

    <h2 class="mt-16 border-b border-border pb-4 font-display text-2xl tracking-tight">
        How I work
    </h2>
    <ul class="mt-8 grid gap-8 sm:grid-cols-3">
        {
            principles.map((item) => (
                <li class="reveal">
                    <span class="grid size-12 place-items-center rounded-2xl bg-accent text-accent-foreground">
                        <item.icon className="size-6" strokeWidth={1.6} aria-hidden="true" />
                    </span>
                    <h3 class="mt-4 font-display text-lg">{item.title}</h3>
                    <p class="mt-1.5 text-sm leading-relaxed text-muted-foreground">{item.body}</p>
                </li>
            ))
        }
    </ul>

    <h2 class="mt-16 border-b border-border pb-4 font-display text-2xl tracking-tight">Timeline</h2>
    <ol class="relative mt-8 border-l border-border pl-10">
        {
            timeline.map((entry) => (
                <li class="reveal relative pb-10 last:pb-0">
                    <span class="absolute -left-[3.75rem] grid size-10 place-items-center rounded-full border border-border bg-card text-primary">
                        <entry.icon className="size-5" strokeWidth={1.6} aria-hidden="true" />
                    </span>
                    <span class="font-mono text-xs leading-10 text-muted-foreground">{entry.period}</span>
                    <h3 class="font-display text-xl">{entry.title}</h3>
                    <p class="mt-1.5 text-muted-foreground">{entry.body}</p>
                </li>
            ))
        }
    </ol>

    <div class="mt-16 flex flex-wrap gap-3">
        <a
            href="/cv.pdf"
            class="rounded-full bg-primary px-6 py-3 text-sm text-primary-foreground transition-[background-color,transform] hover:-translate-y-0.5 hover:bg-foreground hover:text-background"
        >
            Download CV
        </a>
        <a
            href={`mailto:${siteConfig.email}`}
            class="rounded-full border border-border bg-card px-6 py-3 text-sm transition-[border-color,transform] hover:-translate-y-0.5 hover:border-primary"
        >
            Email me
        </a>
    </div>
</Layout>
