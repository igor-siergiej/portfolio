---
import { getEntry } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import { siteConfig } from '@/config/site';

const resume = await getEntry('resume', 'profile');
if (!resume) {
    throw new Error('Resume profile not found at src/content/resume/profile.md');
}
const { headline, location, summary, experience, skills, education } = resume.data;

// Print-stylesheet approach: the same page renders the on-screen and the PDF
// versions — the download button calls window.print() and the print stylesheet
// (`@media print` in src/styles.css) drops the chrome and lays it out on paper.
// This keeps the on-screen and PDF content from drifting: there's a single
// source of truth, the resume collection, and the layout is the same.
---

<Layout title={`${siteConfig.name} — Resume`} description={summary} wide>
    <article class="mx-auto max-w-3xl px-6 py-16 print:max-w-none print:px-0 print:py-0">
        <header class="mb-10 flex flex-wrap items-start justify-between gap-4 print:mb-6">
            <div>
                <h1 class="text-4xl font-semibold tracking-tight">{siteConfig.name}</h1>
                <p class="mt-1 text-lg text-muted-foreground">{headline}</p>
                {location && <p class="mt-1 text-sm text-muted-foreground">{location}</p>}
                <p class="mt-3 text-sm text-muted-foreground">
                    <a class="underline hover:text-foreground" href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a>
                    {siteConfig.social.github && (
                        <>
                            {' · '}
                            <a class="underline hover:text-foreground" href={siteConfig.social.github} rel="me noopener">GitHub</a>
                        </>
                    )}
                    {siteConfig.social.linkedin && (
                        <>
                            {' · '}
                            <a class="underline hover:text-foreground" href={siteConfig.social.linkedin} rel="me noopener">LinkedIn</a>
                        </>
                    )}
                </p>
            </div>
            <button
                type="button"
                class="print:hidden inline-flex items-center gap-2 rounded-full border border-border bg-background px-4 py-2 text-sm font-medium transition-colors hover:bg-accent hover:text-accent-foreground"
                onclick="window.print()"
            >
                Download PDF
            </button>
        </header>

        <section class="mb-10 print:mb-6">
            <h2 class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">Summary</h2>
            <p class="mt-3 text-base leading-relaxed text-foreground/90">{summary}</p>
        </section>

        <section class="mb-10 print:mb-6">
            <h2 class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">Experience</h2>
            <div class="mt-4 space-y-6">
                {experience.map((entry) => (
                    <div>
                        <div class="flex flex-wrap items-baseline justify-between gap-x-4">
                            <h3 class="text-base font-semibold text-foreground">{entry.role} <span class="font-normal text-muted-foreground">· {entry.company}</span></h3>
                            <p class="text-sm text-muted-foreground">{entry.period}{entry.location && ` · ${entry.location}`}</p>
                        </div>
                        {entry.highlights.length > 0 && (
                            <ul class="mt-2 list-disc space-y-1 pl-5 text-sm leading-relaxed text-foreground/90">
                                {entry.highlights.map((highlight) => <li>{highlight}</li>)}
                            </ul>
                        )}
                    </div>
                ))}
            </div>
        </section>

        <section class="mb-10 print:mb-6">
            <h2 class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">Skills</h2>
            <dl class="mt-4 space-y-3">
                {skills.map((group) => (
                    <div class="flex flex-wrap gap-x-3">
                        <dt class="w-32 shrink-0 text-sm font-medium text-foreground">{group.category}</dt>
                        <dd class="flex-1 text-sm text-foreground/90">{group.items.join(' · ')}</dd>
                    </div>
                ))}
            </dl>
        </section>

        <section class="mb-10 print:mb-6">
            <h2 class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">Education</h2>
            <div class="mt-4 space-y-3">
                {education.map((entry) => (
                    <div>
                        <div class="flex flex-wrap items-baseline justify-between gap-x-4">
                            <h3 class="text-base font-semibold text-foreground">{entry.qualification} <span class="font-normal text-muted-foreground">· {entry.institution}</span></h3>
                            <p class="text-sm text-muted-foreground">{entry.period}</p>
                        </div>
                        {entry.details && <p class="mt-1 text-sm text-foreground/90">{entry.details}</p>}
                    </div>
                ))}
            </div>
        </section>

        <footer class="mt-12 border-t border-border pt-6 text-xs text-muted-foreground print:mt-6">
            <p>Source of truth: <code class="font-mono">src/content/resume/profile.md</code> — edit that file to update both this page and the printed PDF.</p>
        </footer>
    </article>
</Layout>
