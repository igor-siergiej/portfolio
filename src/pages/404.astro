---
import Layout from '../layouts/Layout.astro';

export const prerender = true;
---

<Layout title="Page not found">
  <div class="flex min-h-[50vh] flex-col items-start justify-center gap-4">
    <p class="font-mono text-xs text-muted-foreground">404</p>
    <h1 class="font-display text-4xl tracking-tight">Page not found</h1>
    <p class="text-lg text-muted-foreground">The page you're looking for doesn't exist or has moved.</p>
    <a href="/" class="font-mono text-xs text-muted-foreground hover:text-primary">← Back to homepage</a>
  </div>
</Layout>
