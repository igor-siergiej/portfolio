---
import Layout from '../layouts/Layout.astro';

export const prerender = true;
---

<Layout title="Page not found">
  <div class="container mx-auto flex min-h-[60vh] flex-col items-center justify-center gap-4 py-24 text-center">
    <h1 class="text-4xl font-bold">404 — Page not found</h1>
    <p class="text-muted-foreground text-lg">The page you're looking for doesn't exist or has moved.</p>
    <a href="/" class="text-primary underline underline-offset-4">Back to homepage</a>
  </div>
</Layout>
